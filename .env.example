# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=complainmgmt
POSTGRES_USER=cts_app
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ─── Backend (NestJS) ──────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3000
DATABASE_URL=postgres://cts_app:change_me_in_production@db:5432/complainmgmt

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_long_random_secret
JWT_ACCESS_TTL=900            # 15 minutes
JWT_REFRESH_TTL=604800        # 7 days

# Bcrypt cost factor (10–12 typical; raise for production)
BCRYPT_ROUNDS=12

# ─── Two-factor auth (TOTP) ───────────────────────────────────────────────
# 32-byte AES-256-GCM key for encrypting TOTP secrets at rest.
# Generate with:  openssl rand -base64 32
# Without this, the 2FA endpoints respond with TOTP_NOT_CONFIGURED. Rotating
# this key invalidates every enrolled user's 2FA — they'll have to re-enroll.
# Treat it like JWT_SECRET.
TOTP_ENCRYPTION_KEY=

# Attachment limits
ATTACHMENT_MAX_FILES_PER_COMPLAINT=5
ATTACHMENT_MAX_BYTES=2097152  # 2 MB

# CORS — comma-separated origins (dev only; in prod NGINX handles this)
CORS_ORIGINS=https://localhost

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api

# ─── NGINX ─────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
